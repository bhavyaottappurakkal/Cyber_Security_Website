datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  category  String?  @default("general")
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, RESPONDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model NewsItem {
  id        Int      @id @default(autoincrement())
  date      String
  title     String
  excerpt   String?
  tag       String
  icon      String?  @default("📰")
  createdAt DateTime @default(now())

  @@map("news_items")
}

model ResearchProject {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tags        String[]
  icon        String?  @default("🔬")
  createdAt   DateTime @default(now())

  @@map("research_projects")
}

model WhitePaper {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  year        String
  icon        String?  @default("📋")
  createdAt   DateTime @default(now())

  @@map("white_papers")
}
